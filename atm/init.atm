val esp = require "esp32"
val ir = esp.ir
val debug = esp.debug
val gpio = esp.gpio

spawn debug.Mem()
spawn debug.Fps()

ir.start(15)

gpio.setup_pwm(0, 25000, 10)

loop _, p in [19, 18, 4, 23] {
    gpio.attach_pwm(p, 0)
    gpio.write_pwm(0, 0)

    gpio.fade_pwm(0, 1023, 2000)
    await :gpio.pwm_fade
    await :ir [repeat=false]

    gpio.fade_pwm(0, 0, 2000)
    await :gpio.pwm_fade
    await :ir [repeat=false]

    gpio.detach_pwm(p)
}
