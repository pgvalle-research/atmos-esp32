val esp = require "esp32"
val ir = esp.ir
val io = esp.gpio
val debug = esp.debug

ir.start(15)

spawn debug.Mem()
spawn debug.Fps()

val drv = require "ultrat.drv8833"
val brd = require "ultrat.board"
val modes = require "ultrat.modes"

io.setup(brd.S_ESQ, "input")
io.setup(brd.S_FESQ, "input")
io.setup(brd.S_FDIR, "input")
io.setup(brd.S_DIR, "input")
drv.setup()

await modes.ISeeYou()