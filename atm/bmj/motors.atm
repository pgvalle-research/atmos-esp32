set motors = []
val pins = require "pins"

;;; MOTORES ;;;

val PWM_MAX = 1023

val RODA_ESQ_M1 = pins.MA2
val RODA_ESQ_M2 = pins.MA1
val RODA_DIR_M1 = pins.MB2
val RODA_DIR_M2 = pins.MB1

func motor(m1, m2, vel) {
    if (vel < 0) {
        gpio.write_pwm(m1, abs(vel));
        gpio.write_pwm(m2, 0);
    } else {
        gpio.write_pwm(m1, 0);
        gpio.write_pwm(m2, vel);
    }
}

func motors.setup() {
    gpio.mode(RODA_ESQ_M1, "output")
    gpio.mode(RODA_ESQ_M2, "output")
    gpio.mode(RODA_DIR_M1, "output")
    gpio.mode(RODA_DIR_M2, "output")
}

func motors.move(vel_esq, vel_dir) {
    motor(RODA_ESQ_M1, RODA_ESQ_M2, vel_esq);
    motor(RODA_DIR_M1, RODA_DIR_M2, vel_dir);
}

func motors.stop() {
    gpio.write_pwm(roda_esq_m1, PWM_MAX);
    gpio.write_pwm(roda_esq_m2, PWM_MAX);
    gpio.write_pwm(roda_dir_m1, PWM_MAX);
    gpio.write_pwm(roda_dir_m2, PWM_MAX);
    ;; move(0, 0)
}

return(motors)
