val esp = require "esp32"
val prefs = esp.preferences
val gpio = esp.gpio
val board = require "ultrat.board"

val M = []
set M.startCmd = 0
set M.stopCmd = 0
set M.prepareCmd = 0

val LEARN_PIN = 0
val LEARN_TIMEOUT_MS = 10000ms

task AwaitButton() {
    var cmd = 0
    watching LEARN_TIMEOUT_MS {
        loop {
            while((cmd == 0) || (cmd == M.startCmd) || (cmd == M.stopCmd) || (cmd == M.prepareCmd))
            val sta = await :ir [repeat=false]
            set cmd = sta.command
        }
    }

    if cmd == 0 => print("Timeout. Learning stoped. Try again")
                => print("got " ++ cmd)

    cmd
}

func printCommands() {
    print("start: " ++ M.startCmd)
    print("stop: " ++ M.stopCmd)
    print("prepare: " ++ M.prepareCmd)
}

func saveCommands() {
    prefs.begin("commands")
    prefs.put_int("start", M.startCmd)
    prefs.put_int("prepare", M.prepareCmd)
    prefs.put_int("stop", M.stopCmd)
    prefs.close()
}

set M.Start = task () {
    prefs.begin("commands")

    ;; learning
    if gpio.read(LEARN_PIN) == true {
        print("Boot pressed. Learning mode")

        ;; start command
        print("awaiting start cmd")
        val sta = await AwaitButton()
        if sta == 0 => return()
                    => set M.startCmd = sta

        ;; prepare command
        print("waiting for prepare command")
        val pre = await AwaitButton()
        if pre == 0 => return()
                    => set M.prepareCmd = pre

        ;; stop command
        print("waiting for stop command")
        val sto = await :ir [repeat=false]
        set M.stopCmd = sto.command

        saveCommands()
        print("cmd codes saved")
    } else {
        ;; load saved
    }
}

M