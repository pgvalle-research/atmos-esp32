val esp = require "esp32"
val io = esp.gpio

;; robot imports
val drv = require "ultrat.drv8833"
val board = require "ultrat.board"

val KP, KI, KD = (450, 0, 0)

io.read(board.S_ESQ, "input")
io.read(board.S_FESQ, "input")
io.read(board.S_FDIR, "input")
io.read(board.S_DIR, "input")

val func read_sensors() {
    [ io.read(board.S_ESQ),
      io.read(board.S_FESQ),
      io.read(board.S_FDIR),
      io.read(board.S_DIR) ]
}

val func calculate_error(readings) {
    val weights = [-4, -2, 2, 4]
    var w_sum = 0
    var active = 0

    loop i in (1, 4) {
        if readings@i != 0 {
            set w_sum = w_sum + weights@i
            set active = active + 1
        }
    }

    if (active == 0) => 0
                     => (w_sum / active)
}

task () {
    var err_before = 0
    var i_before = 0
    var tgt_before = false

    loop {
        val dt = await :clock    ;; as fast as possible
        val readings = read_sensors()
        val err = calculate_error(readings)

        val tgt = err != 0 ;; tricky way to get this tho
        if tgt != tgt_before {
            ;; very abstract
            emit @(:parent) (:TARGET [tgt])
        }

        val p = err
        val i = (err * dt) + i_before
        val d = (err - err_before) / dt
        val pid = (KP * p) + (KI * i) + (KD * d)
        emit @(:parent) (:PID [pid, readings])

        set err_before = err
        set i_before = i
        set tgt_before = tgt
    }
}