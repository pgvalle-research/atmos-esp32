;; TODO: tasks em maiusculas

val modes = []

val Pid = require "pid"
val drv = require "drv8833"

task modes.i_see_you() {
    spawn Pid()
    loop {
        await :TARGET [true]
        spawn {
            loop {
                val pid, _ = await :PID
                if pid == 0 => drv.move(1023, 1023)
                            => drv.move(pid, -pid)
            }
        }
        await :TARGET [false]
        motors.stop()
    }
}

task modes.calibration() {
    spawn Pid()
    loop {
        await :TARGET [true]
        spawn {
            loop {
                val pid, _ = await :PID
                if pid == 0 => drv.stop()
                            => drv.move(-pid, pid)
            }
        }
        await :TARGET [false]
        motors.stop()
    }
}

task modes.backward() {
    await drv.move_for(1023, 1023, 500ms)
    await drv.move_for(-1023, 1023, 350ms)
    await modes.i_see_you()
}

task modes.whiplash() {
    await drv.move_for(1023, 1023, 300ms)
    await drv.move_for(1023, -1023, 50ms)
    await modes.i_see_you()
}

task modes.sharingan() {
    val choice = math.random(1, 2)
    match choice {
        1    => drv.move(-900, 900)
        else => drv.move(900, -900);
    }

    await 150ms
    await modes.whiplash()
}

modes
