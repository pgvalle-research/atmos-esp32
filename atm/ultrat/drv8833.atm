val esp32 = require "esp32"
val gpio = esp32.gpio

val drv8833 = []

;; led control channels
val LC1 = 0
val LC2 = 1
val RC1 = 2
val RC2 = 3

func drv8833.setup(l1, l2, r1, r2) {
    gpio.setup_pwm(LC1, 25000, 10);
    gpio.setup_pwm(LC2, 25000, 10);
    gpio.setup_pwm(RC1, 25000, 10);
    gpio.setup_pwm(RC2, 25000, 10);
    gpio.attach_pwm(l1, LC1);
    gpio.attach_pwm(l2, LC2);
    gpio.attach_pwm(r1, RC1);
    gpio.attach_pwm(r2, RC2);
    drv8833.reset();
}

func drv8833.set(vl, vr) {
    ;; left (slow decay)
    if vl >= 0 {
        gpio.write_pwm(LC1, 1023)
        gpio.write_pwm(LC2, 1023 - math.min(vl, 1023))
    } else {
        gpio.write_pwm(LC1, 1023 - math.min(-vl, 1023))
        gpio.write_pwm(LC2, 1023)
    }
    ;; right (slow decay)
    if vr >= 0 {
        gpio.write_pwm(RC1, 1023)
        gpio.write_pwm(RC2, 1023 - math.min(vr, 1023))
    } else {
        gpio.write_pwm(RC1, 1023 - math.min(-vr, 1023))
        gpio.write_pwm(RC2, 1023)
    }
}

func drv8833.reset() {
    gpio.write_pwm(LC1, 1023)
    gpio.write_pwm(LC2, 1023)
    gpio.write_pwm(RC1, 1023)
    gpio.write_pwm(RC2, 1023)
}

set drv8833.Move = task (vl, vr, dt) {
    drv8833.set(vl, vr)
    await(dt)
    drv8833.reset()
}

drv8833
