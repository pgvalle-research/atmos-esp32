val esp32 = require "esp32"
val gpio = esp32.gpio

val drv8833 = []

;; led control channels
val L1 = 0
val L2 = 1
val R1 = 2
val R2 = 3

func drv8833.setup() {
    gpio.setup_pwm(L1, 25000, 10);
    gpio.setup_pwm(L2, 25000, 10);
    gpio.setup_pwm(R1, 25000, 10);
    gpio.setup_pwm(R2, 25000, 10);
    gpio.attach_pwm(brd.MB1, L1);
    gpio.attach_pwm(brd.MB2, L2);
    gpio.attach_pwm(brd.MA1, R1);
    gpio.attach_pwm(brd.MA2, R2);
    drv8833.reset();
}

func drv8833.set(vl, vr) {
    val l = (vl + 0.5) // 1
    val r = (vr + 0.5) // 1
    ;; left (slow decay)
    if l >= 0 {
        gpio.write_pwm(L1, 1023)
        gpio.write_pwm(L2, 1023 - math.min(l, 1023))
    } else {
        gpio.write_pwm(L1, 1023 - math.min(-l, 1023))
        gpio.write_pwm(L2, 1023)
    }
    ;; right (slow decay)
    if r >= 0 {
        gpio.write_pwm(R1, 1023)
        gpio.write_pwm(R2, 1023 - math.min(r, 1023))
    } else {
        gpio.write_pwm(R1, 1023 - math.min(-r, 1023))
        gpio.write_pwm(R2, 1023)
    }
}

func drv8833.reset() {
    gpio.write_pwm(L1, 1023)
    gpio.write_pwm(L2, 1023)
    gpio.write_pwm(R1, 1023)
    gpio.write_pwm(R2, 1023)
}

set drv8833.Move = task (vl, vr, dt) {
    drv8833.set(vl, vr)
    await(dt)
    drv8833.reset()
}

drv8833
